# Browser-visible configuration only. Never place passwords or JWT secrets here.
# Browser connects through the same-origin reverse proxy: /api -> N4 HTTPS Tomcat.
VITE_API_BASE_PATH=/api

# Vite development proxy target (Node/Vite server-side; not embedded in browser JS).
# Use a TLS hostname trusted by Node. Do not disable TLS verification.
N4_API_TARGET=https://localhost:8181

# For a private development CA, set NODE_EXTRA_CA_CERTS outside this file
# to a PEM containing the trusted CA certificate (e.g. mkcert rootCA.pem).
# The browser origin must match N4 AUTH_ALLOWED_ORIGIN exactly.
